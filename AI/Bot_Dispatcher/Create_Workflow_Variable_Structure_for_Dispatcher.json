      {
        "unique_name": "definition_activity_02UE25F767ZS415Bh2gmgaFmW5tcNdetAM4",
        "name": "Execute Python Script",
        "title": "Execute Python Script",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Execute Python Script",
          "display_name": "Execute Python Script",
          "script": "import sys\nimport json\n\n\ndef reduce_workflow_json(input_json):\n\n    output = {\n        \"input_variables\": []\n    }\n\n    for var in input_json.get(\"input_variables\", []):\n\n        var_id = var.get(\"id\")\n\n        props = var.get(\"properties\", {})\n\n        description = (\n            props.get(\"description\") or\n            props.get(\"name\") or\n            \"No description provided\"\n        ).strip()\n\n        is_required = props.get(\"is_required\", False)\n\n        # Optional type hint (helps your dispatcher)\n        var_type = props.get(\"type\", \"\").replace(\"datatype.\", \"\")\n\n        # Build value string\n        if is_required:\n            value = f\"<{var_type}: {description}>\" if var_type else f\"<{description}>\"\n        else:\n            value = f\"<Optional {var_type}: {description}>\" if var_type else f\"<Optional: {description}>\"\n\n        output[\"input_variables\"].append({\n            \"id\": var_id,\n            \"properties\": {\n                \"value\": value\n            }\n        })\n\n    return output\n\n\n# -----------------------------\n# JSON Validation Layer\n# -----------------------------\ndef ensure_json_safe(data):\n    \"\"\"\n    Ensures output is valid JSON:\n    - serializable\n    - properly formatted\n    \"\"\"\n    try:\n        # Serialize + deserialize to guarantee validity\n        json_string = json.dumps(data)\n        return json.loads(json_string)\n\n    except Exception as e:\n        # Fallback safe response\n        return {\n            \"input_variables\": [],\n            \"error\": f\"JSON serialization failed: {str(e)}\"\n        }\n\n\n# -----------------------------\n# Cisco Workflow Entry Point\n# -----------------------------\ntry:\n    input_json = json.loads(sys.argv[1])\nexcept Exception:\n    input_json = {}\n\nraw_result = reduce_workflow_json(input_json)\n\n# Validate / normalize output\nresult = ensure_json_safe(raw_result)",
          "script_arguments": [
            "$activity.definition_activity_02U36XFGLU6KJ7et0OXLaCkt9e5Hq7buoD9.output.response_body$"
          ],
          "script_queries": [
            {
              "script_query": "result",
              "script_query_name": "result",
              "script_query_type": "object"
            }
          ],
          "skip_execution": false
        },
